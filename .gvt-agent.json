{
  "project": {
    "name": "c3source",
    "description": "Typed interfaces and traversal/formatting utilities for reading and mutating Construct 3 project source files (layouts, layers, instances, event sheets) on disk.",
    "languages": [
      "typescript"
    ]
  },
  "commands": {
    "test": "npm run test",
    "lint": "npm run lint",
    "build": "npm run build",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repo": {
    "host": "github",
    "default_branch": "main"
  },
  "bugTracker": {
    "kind": "github",
    "actionQuery": "gh issue list --state open -L 200 --json number,title,labels,body,assignees,createdAt,milestone",
    "comparisonQuery": "gh issue list --state all -L 500 --json number,title,labels,state",
    "readOne": "gh issue view {id} --json number,title,body,labels,comments",
    "commentsQuery": "gh issue list --state open -L 200 --json number,comments",
    "structureQuery": "gh issue list --state open -L 200 --json number,parent,subIssuesSummary",
    "refStateQuery": "gh api repos/{repo}/issues/{id} --jq '{number,state,state_reason,closed_at,pull_request:(.pull_request != null),sub_issues_summary}'",
    "triagedLabel": "triaged",
    "needsInfoLabel": "question"
  },
  "wiki": {
    "wikiDir": "wiki",
    "rawDir": "raw"
  },
  "features": {},
  "paths": {
    "docs/decisions/": "wiki/decisions/",
    "docs/TOC.md": "wiki/index.md",
    "docs/issue-triage.md": "wiki/issue-triage.md",
    "docs/architecture.md": "wiki/module-architecture.md",
    "docs/design-patterns.md": "wiki/design-patterns.md"
  }
}
